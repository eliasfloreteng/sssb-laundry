          }
        }
      }
    },
    "Aptus couldn’t complete the request.": {
      "comment": "Fallback explanation when the service gave no reason",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus couldn’t complete the request."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus kunde inte utföra begäran."
          }
        }
      }
    },
    "Aptus didn’t accept your object number": {
      "comment": "Reason clause: the object number was rejected",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus didn’t accept your object number"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus godkände inte ditt objektsnummer"
          }
        }
      }
    },
    "Aptus didn’t accept your object number. Check it and sign in again.": {
      "comment": "What to do about a rejected object number",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus didn’t accept your object number. Check it and sign in again."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus godkände inte ditt objektsnummer. Kontrollera det och logga in igen."
          }
        }
      }
    },
    "Aptus is having trouble right now. Try again in a few minutes.": {
      "comment": "What to do when the booking system is failing",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus is having trouble right now. Try again in a few minutes."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus krånglar just nu. Försök igen om några minuter."
          }
        }
      }
    },
    "Aptus no longer lists this timeslot — refresh and try again": {
      "comment": "Reason clause: the timeslot is gone from the portal",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus no longer lists this timeslot — refresh and try again"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus listar inte längre det här tvättpasset — uppdatera och försök igen"
          }
        }
      }
    },
    "Aptus no longer offers this time — refresh and try again": {
      "comment": "Reason clause: the timeslot is gone from the portal",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus no longer offers this time — refresh and try again"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus erbjuder inte längre den här tiden — uppdatera och försök igen"
          }
        }
      }
    },
    "Aptus problem": {
      "comment": "Error headline: the booking system misbehaved",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus problem"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem med Aptus"
          }
        }
      }
    },
    "Aptus replied with something unexpected. Try again in a moment.": {
      "comment": "What to do when the response couldn't be read",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus replied with something unexpected. Try again in a moment."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus svarade med något oväntat. Försök igen om en stund."
          }
        }
      }
    },
    "Aptus took too long to answer. Try again in a moment.": {
      "comment": "What to do when the request timed out",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus took too long to answer. Try again in a moment."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus svarade inte i tid. Försök igen om en stund."
          }
        }
      }
    },
    "Aptus turned it down — most likely someone just took it, or you already hold as many sessions as your laundry room allows": {
      "comment": "Reason clause for a refused booking, with no published session limit to name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus turned it down — most likely someone just took it, or you already hold as many sessions as your laundry room allows"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus nekade — troligen hann någon annan före, eller så har du redan lika många pass som din tvättstuga tillåter"
          }
        }
      }
    },
    "Aptus turned it down — most likely someone just took it, or you already hold the maximum of %lld sessions": {
      "comment": "Reason clause for a refused booking, naming the laundry room's session limit",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus turned it down — most likely someone just took it, or you already hold the maximum of %lld sessions"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus nekade — troligen hann någon annan före, eller så har du redan max antal bokade pass (%lld)"
          }
        }
      }
    },
    "Aptus won’t release a session that has already started": {
      "comment": "Reason clause: the session is already running",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptus won’t release a session that has already started"
