    "A session you haven’t tagged into within 15 minutes is released to everyone again.": {
      "comment": "Booking rule shown on the sign-in screen",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A session you haven’t tagged into within 15 minutes is released to everyone again."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett pass du inte aktiverat inom 15 minuter avbokas automatiskt och blir ledigt för alla igen."
