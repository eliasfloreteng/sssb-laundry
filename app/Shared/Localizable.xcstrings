{
  "sourceLanguage": "en",
  "strings": {
    "%@ are free for anyone to book now.": {
      "comment": "Receipt after releasing several groups",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ are free for anyone to book now."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är nu lediga för vem som helst att boka."
          }
        }
      }
    },
    "%@ are released the moment you cancel — anyone else can book them then.": {
      "comment": "Warning before releasing several booked groups",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ are released the moment you cancel — anyone else can book them then."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ släpps så fort du avbokar — då kan vem som helst boka dem."
          }
        }
      }
    },
    "%@ are yours. Tag in within 15 minutes of the start or the booking is released.": {
      "comment": "Receipt after booking several groups",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ are yours. Tag in within 15 minutes of the start or the booking is released."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är dina. Aktivera inom 15 minuter efter start, annars avbokas passet."
          }
        }
      }
    },
    "%@ is free for anyone to book now.": {
      "comment": "Receipt after releasing one group",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is free for anyone to book now."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är nu ledig för vem som helst att boka."
          }
        }
      }
    },
    "%@ is released the moment you cancel — anyone else can book it then.": {
      "comment": "Warning before releasing one booked group",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is released the moment you cancel — anyone else can book it then."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ släpps så fort du avbokar — då kan vem som helst boka det."
          }
        }
      }
    },
    "%@ is yours. Tag in within 15 minutes of the start or the booking is released.": {
      "comment": "Receipt after booking one group",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
